# ==============================================================================
# SmartCart 2.0 Environment Configuration
# Team: Hack Hive | CIT Gubbi | Build Bangalore 2.0
# Mandatory Stack: Aiven PostgreSQL, Aiven Apache Kafka, Aiven OpenSearch
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="SmartCart 2.0"
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-in-production-to-a-very-secure-random-32-byte-hex-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Aiven PostgreSQL Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://avnadmin:your-password@your-pg-host.aivencloud.com:port/defaultdb?ssl=require
# Synchronous DB URL for Alembic migrations if needed:
DATABASE_SYNC_URL=postgresql://avnadmin:your-password@your-pg-host.aivencloud.com:port/defaultdb?sslmode=require

# Aiven Apache Kafka Connection (SSL / mTLS or SASL_SSL)
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host.aivencloud.com:port
KAFKA_SECURITY_PROTOCOL=SSL
# If using SASL_SSL:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=your-kafka-sasl-password

# Paths to certificate files or inline base64 cert strings for SSL / mTLS deployment:
KAFKA_SSL_CA_PEM_PATH=./backend/certs/ca.pem
KAFKA_SSL_CERT_PEM_PATH=./backend/certs/service.cert
KAFKA_SSL_KEY_PEM_PATH=./backend/certs/service.key
# Optional Base64 encoded certs for container/cloud deployment (Render):
# KAFKA_SSL_CA_B64=
# KAFKA_SSL_CERT_B64=
# KAFKA_SSL_KEY_B64=

# Kafka Consumer & Producer Settings
KAFKA_CONSUMER_GROUP_ID=smartcart-orders-consumer-group
KAFKA_PRODUCER_TIMEOUT_SECONDS=10
KAFKA_CONSUMER_TIMEOUT_MS=1000
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF_MS=500

# Kafka Canonical Topics
KAFKA_TOPIC_ORDERS=smartcart.orders
KAFKA_TOPIC_INVENTORY=smartcart.inventory
KAFKA_TOPIC_DLQ=smartcart.dlq

# Kafka Legacy Topic Aliases
KAFKA_TOPIC_ORDER_PLACED=smartcart.orders
KAFKA_TOPIC_ORDER_CANCELLED=smartcart.orders
KAFKA_TOPIC_INVENTORY_CHANGED=smartcart.inventory
KAFKA_TOPIC_PRODUCT_CHANGED=smartcart.products
KAFKA_TOPIC_SEARCH_EVENTS=smartcart.search
KAFKA_TOPIC_ORDER_PLACED_DLQ=smartcart.dlq

# Aiven OpenSearch Connection
# Either provide a complete OPENSEARCH_URL (e.g. https://avnadmin:pass@host:port) or individual host/credentials:
# OPENSEARCH_URL=https://avnadmin:your-password@your-opensearch-host.aivencloud.com:port
OPENSEARCH_HOST=your-opensearch-host.aivencloud.com
OPENSEARCH_PORT=port
OPENSEARCH_USER=avnadmin
OPENSEARCH_PASSWORD=your-opensearch-password
OPENSEARCH_USE_SSL=True
OPENSEARCH_VERIFY_CERTS=True
OPENSEARCH_INDEX_PRODUCTS=smartcart_products

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Or combined URL:
# CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
CLOUDINARY_UPLOAD_FOLDER=smartcart/products
